{
  "name": "@fusion-plugin-examples/todos",
  "version": "0.1.5-beta.3",
  "type": "module",
  "private": true,
  "description": "Todo Lists plugin package for Fusion",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "source": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./dashboard-view": {
